---
import Layout from "@/layouts/Layout.astro";
import {GITHUB_URL} from "@/data/env";
import GitHubMark from "@/assets/github.svg";
import ClaudeMark from "@/assets/claude.svg";

const roles: { name: string; blurb: string; color: string; ink: string }[] = [
    { name: "Architect", blurb: "Shapes the work: turns a rough idea into a plan, and splits it into pieces small enough to finish.", color: "#FBCA04", ink: "#1F2328" },
    { name: "Implementor", blurb: "Writes the app code, one piece at a time.", color: "#1D76DB", ink: "#FFFFFF" },
    { name: "Designer", blurb: "Owns the look and feel — the shared buttons, inputs and type everything else is built from.", color: "#B5257A", ink: "#FFFFFF" },
    { name: "Tester", blurb: "Writes the checks, from what the product promised rather than from what got built.", color: "#0E8A16", ink: "#FFFFFF" },
    { name: "Writer", blurb: "Keeps the written record straight: what the product does, and why it works the way it does.", color: "#5319E7", ink: "#FFFFFF" },
    { name: "Security", blurb: "Reviews every change that ships, and raises what it finds.", color: "#B60205", ink: "#FFFFFF" },
];

const CLAUDE_TEAM_URL = `${GITHUB_URL}/tree/mainline/packages/claude-team`;
---
<Layout title="Claude Team">
    <main
        class="min-h-screen w-screen flex flex-col items-center px-6 pt-24 pb-16 lg:pt-28"
        style="background-image: linear-gradient(to bottom, color-mix(in oklab, var(--color-base-200) 85%, transparent) 65%, var(--color-base-300) 100%);">
        <div class="flex items-center gap-5 text-base-content/50">
            <GitHubMark class="h-6 w-6 fill-current" />
            <ClaudeMark class="h-6 w-6 fill-current" />
        </div>

        <h1 class="mt-5 text-3xl lg:text-4xl font-semibold tracking-tight">Claude Team</h1>

        <div class="mt-8 lg:max-w-screen-md text-left flex flex-col gap-4">
            <p class="px-5">
                Claude Team is a project built for BrewDocs. It's a way of running a software
                project where a team of AI agents does the work in the open, on GitHub, each one
                with a job it owns and a person deciding what happens next.
            </p>
            <p class="px-5">
                BrewDocs is built with it. Nearly everything on this site and in the app was
                planned, written, reviewed and documented by that team — which makes BrewDocs both
                its first home and its proving ground.
            </p>

            <div class="flex flex-col gap-3">
                <div class="rounded-box glass p-5 [box-shadow:inset_0_0_0_1px_oklch(100%_0_0/22%)]">
                    <div class="text-xs font-mono uppercase tracking-widest text-primary">Big idea to small change</div>
                    <p class="mt-2 text-base">
                        Work moves through three sizes. An <strong>epic</strong> is the ambition —
                        "brew day should work without a signal". A <strong>story</strong> is one
                        useful slice of it, shipped on its own. A <strong>task</strong> is a single
                        change one agent can finish and hand over. Each size has its own place to
                        be reviewed, so nothing lands without someone having looked at it.
                    </p>
                </div>
                <div class="rounded-box glass p-5 [box-shadow:inset_0_0_0_1px_oklch(100%_0_0/22%)]">
                    <div class="text-xs font-mono uppercase tracking-widest text-primary">Compartmentalized roles</div>
                    <div class="mt-3 grid grid-cols-[auto_1fr] items-baseline gap-x-4 gap-y-2">
                        {roles.map(({ name, blurb, color, ink }) => (
                            <Fragment>
                                <span
                                    class="badge badge-sm border-transparent font-semibold justify-self-start"
                                    style={`background-color: ${color}; color: ${ink};`}>{name}</span>
                                <span class="text-base opacity-80">{blurb}</span>
                            </Fragment>
                        ))}
                    </div>
                </div>
                <div class="rounded-box glass p-5 [box-shadow:inset_0_0_0_1px_oklch(100%_0_0/22%)]">
                    <div class="text-xs font-mono uppercase tracking-widest text-primary">A person is always driving</div>
                    <p class="mt-2 text-base">
                        No agent starts another, and none of them can ship. Every run begins with a
                        person asking for it, and every change ends with a person choosing to merge
                        it. What the agents produce is a trail anyone can read: the plan, the
                        change, the review, and the reasoning behind each.
                    </p>
                </div>
            </div>

            <div class="px-5">
                <p>
                    Claude Team isn't specific to brewing software: it's a set of role instructions,
                    a GitHub workflow and a few small scripts, with no application code of its own.
                    BrewDocs keeps it in a self-contained package rather than woven through the app,
                    so another project can adopt it by copying that package.
                </p>
                <p class="mt-3">
                    If you want the details, the whole thing is public: the instructions each role
                    runs on, the scripts that do the bookkeeping, and the reasoning behind every
                    awkward decision.
                </p>
                <div class="mt-5 flex flex-wrap gap-3">
                    <a href={CLAUDE_TEAM_URL} class="btn btn-primary">Read the source</a>
                </div>
            </div>
        </div>
    </main>
</Layout>
