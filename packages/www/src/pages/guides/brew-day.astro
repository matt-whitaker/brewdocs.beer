---
import Layout from "@/layouts/Layout.astro";
import PhoneMockup from "@/components/phone-mockup.astro";
import {APP_URL} from "@/data/env";

type Figure = {
    src: string;
    alt: string;
    caption: string;
};

type Step = {
    number: string;
    title: string;
    lead: string;
    body: string[];
    figures: Figure[];
};

const steps: Step[] = [
    {
        number: "01",
        title: "Open the batch on Brewing",
        lead: "Planning was the plan. Brewing is the day itself — a timer above, and the phase you are working through below it.",
        body: [
            "A batch has four tabs, and Brewing is the brew-day one. It opens with the session timer across the top and a strip of phase tabs under it: Prep first, then one tab per phase in the order the batch will run — 1. Mash, 2. Boil, 3. Ferment — and Notes at the end. The phase you are on fills the rest of the screen.",
            "Prep is worth a moment before you start heating anything. It holds the batch's Brewed on date and its Packaging — Keg or Bottle — and both belong to the batch rather than to any one phase, so they keep whatever you set regardless of how far the day gets. Notes, at the other end of the strip, is where the batch's SRM and any free-text notes live; SRM reads 0 until you measure one rather than starting blank, and a colour swatch appears beside it as soon as you enter a real number.",
            "A phase's own tab lists everything assigned to it, grouped by kind — Equipment first, then Grains, Hops, Yeasts and Additives as the phase has them. Within a kind, anything carrying a boil time is listed longest-boil first, so a 60-minute addition sits above a 15-minute one and reading the phase top to bottom is reading it in the order it happens. Grains and yeasts have no boil time to sort on, so they stay in the order you arranged while planning.",
            "One thing that surprises people: a phase you gave nothing to shows an empty grid, and its tab is disabled so you cannot switch to it by hand. It can still become the current phase by completing the one before it, and it can still be completed itself — there is simply nothing on it to check off."
        ],
        figures: [
            {
                src: "/images/guides/brew-day/schedule-mash.png",
                alt: "A batch open on the Brewing tab on a phone, with the timer at 00:00:00 above the Prep, 1. Mash, 2. Boil, 3. Ferment and Notes tabs, and the mash's equipment and grains listed below",
                caption: "The Brewing tab on 1. Mash: the session timer above, the phase strip under it, and the mash's equipment and grains ready to work through."
            }
        ]
    },
    {
        number: "02",
        title: "Check things off as you use them",
        lead: "Every row on the phase carries a checkbox, and every ingredient carries the weight you planned for it.",
        body: [
            "Tapping a row's checkbox marks it done immediately, and it stays done — leave the batch, come back, reload the page, and the mash tun you sanitised is still ticked. There is no save step and no separate record of how something got checked off.",
            "Ingredients carry a little more. Beside each one is its planned amount, and that field is yours to type over: enter what actually went into the kettle and BrewDocs records it as the actual while the plan keeps showing alongside it. That is the whole point of the pair — the recipe said 1.0oz, you weighed 1.15oz, and the batch remembers both. The same holds for a hop's boil time, and for an additive's weight whether or not that addition is boil-timed.",
            "Nothing here locks as the day goes on. Ingredients and equipment stay editable however far through you are, including after every phase has been checked off, so a weight you fat-fingered at mash-in is still fixable while the beer is fermenting."
        ],
        figures: [
            {
                src: "/images/guides/brew-day/timer-running.png",
                alt: "The mash phase on a phone with the timer running at 00:45:12, and the mash tun, long thermometer and German Pils rows ticked",
                caption: "Three rows checked off mid-mash. Each ingredient keeps its planned weight beside it, ready to be typed over with what actually went in."
            }
        ]
    },
    {
        number: "03",
        title: "Record the readings you take",
        lead: "Gravity, volume and temperature belong to the phase you took them in.",
        body: [
            "Every phase offers Gravity, Volume and Temperature groups under its ingredients. Add a reading, give it a name, set its value, and expand it if you want to set the date it was taken — each one survives a reload like everything else on the batch. Removing a reading deletes it outright; it does not come back later.",
            "The greyed-out numbers in an empty value field — 12, 5.5, 68 — are examples of the shape the field wants, not values. They vanish the moment you type, and an untouched field records nothing at all.",
            "Some readings only appear where they mean something. Water Chemistry is offered on a mash and nowhere else; Pressure and a Keg date belong to a carbonation phase; a Bottle date to a conditioning one. The effect is that you cannot log a keg pressure against a phase the beer has not reached yet. A yeast row has its own version of this — expand it and you get a Yeast Pitched date to set."
        ],
        figures: [
            {
                src: "/images/guides/brew-day/readings.png",
                alt: "The mash phase scrolled down on a phone, showing Gravity, Volume and Temperature reading groups with a recorded 152°F temperature, and a Water Chemistry group below",
                caption: "A mash temperature recorded at 152°F. The pale 12, 5.5 and 68 are examples, not values — and Water Chemistry appears here because this is a mash."
            }
        ]
    },
    {
        number: "04",
        title: "Run the timer",
        lead: "One control starts the session, pauses it and picks it up again.",
        body: [
            "The control at the top left of the timer panel reads Start timer before the session has begun and whenever it is paused, and Pause timer while it is running. There is no separate resume — pausing and picking back up are the same intent, so one button answers both, which matters when you are reaching for it with one wet hand.",
            "Beside the counter is a Global/Phase toggle. Global, the default, counts the whole brew session; Phase counts only the time inside the phase you are on, and it leaves out any time you had the timer paused since that phase began. Switching between them changes nothing but what you are looking at — the timer keeps running, or stays paused, exactly as it was.",
            "The bar under the counter is the timeline, and the two scopes show different things on it deliberately. Global marks one start and one complete per phase that has begun, because every reading and hop addition from a whole brew day plotted at that scale would be unreadable. Phase shows that phase's own milestones, positioned relative to when the phase started — a hop logged 30 seconds in sits at 0:30 — plus its completion marker once it is done.",
            "The session survives a reload. Refresh mid-boil and the counter picks up where it should be, still running; if it was paused, it comes back paused at the same number."
        ],
        figures: [
            {
                src: "/images/guides/brew-day/timer-phase.png",
                alt: "The Brewing tab on a phone with the timer at 00:45:12 and the Phase option selected on the Global/Phase toggle",
                caption: "The same session read as Phase rather than Global. The counter and timeline change scope; the timer itself carries on untouched."
            }
        ]
    },
    {
        number: "05",
        title: "Log without leaving the kettle",
        lead: "The Log button opens one panel for the three things you might want to record.",
        body: [
            "Log opens a Quick action panel with three tabs, always in the same order: Ingredients, Reading, Equipment. One entry point rather than three means you do not have to decide what kind of thing you are recording before you have found the control — you tap the same button every time and pick the tab once you are there. The panel names the phase it is recording against, so there is no doubt where it is going.",
            "The Ingredients tab has the item already chosen for you: the first thing on the phase you have not checked off yet, following the same order the phase is listed in. Working down a boil is therefore one confirm per addition, and you only have to intervene when you want something out of order. The value field arrives pre-filled with that item's planned weight, so the number you would otherwise be retyping at the kettle is already there — type over it, or clear it, and whatever you submit is what gets recorded.",
            "Equipment is the same idea with nothing to enter: name the piece of kit and confirm. Reading asks for the kind, an optional label, and the value — leave the label blank and the reading keeps its kind's default name. If a tab has nothing left to offer on this phase, it reads as unavailable rather than taking a tap and doing nothing.",
            "What comes out the other side is not a special kind of entry. Confirming a quick action ticks that item on the phase exactly as if you had reached down and tapped its checkbox — same row, same tick, no separate record of which route you took."
        ],
        figures: [
            {
                src: "/images/guides/brew-day/quick-actions.png",
                alt: "The Quick action panel open on a phone over the mash, showing Ingredients, Reading and Equipment tabs with Crystal Malt 40L selected and a weight of 1.0lb pre-filled",
                caption: "Crystal Malt 40L is picked because it is the next thing unchecked, and 1.0lb is its planned weight — confirm as-is, or type what you actually weighed."
            }
        ]
    },
    {
        number: "06",
        title: "Complete the phase and move on",
        lead: "Completing a phase is the one thing on brew day that cannot be undone.",
        body: [
            "The Complete button at the top right of the timer panel names the phase it will finish — Complete 1. Mash — and asks you to confirm before it does. The warning is meant literally: there is no way back from a completed phase, so it is worth a glance at the grid first. You do not have to have checked everything off; the button does not wait for a full phase.",
            "Confirming moves you on to the phase that follows, because the next thing you want is almost never another look at what you just finished. Completing the last phase leaves you where you are, there being nothing after it.",
            "It also stops the timer, if the timer was running: the control goes back to reading Start timer and the counter stops. The next phase does not begin timing on its own — you press Start yourself when you actually start work on it, rather than letting the clock run through however long it takes you to get there. If the timer was already paused, or you never started it, completing a phase leaves it exactly as it was.",
            "One thing to know before you confirm the first one: completing any phase locks the batch's Planning → Phases sub-tab for good. Adding, removing and reordering phases all stop being available, because the schedule you have been checking work off against would otherwise stop describing the day that actually happened. Ingredients and equipment stay editable; only the shape of the day is fixed."
        ],
        figures: [
            {
                src: "/images/guides/brew-day/complete-phase.png",
                alt: "The Complete 1. Mash confirmation dialog open on a phone, reading This can't be undone, with Close and Confirm buttons",
                caption: "Completing a phase asks first, and means it — confirming advances the batch to the boil and stops the running timer."
            }
        ]
    }
];
---
<Layout title="Brew Day with BrewDocs">
    <main
        class="min-h-screen w-screen flex flex-col items-center px-6 pt-24 pb-16 lg:pt-28"
        style="background-image: linear-gradient(to bottom, color-mix(in oklab, var(--color-base-200) 85%, transparent) 65%, var(--color-base-300) 100%);">

        <div class="text-xs font-mono uppercase tracking-widest text-primary">Guide</div>

        <h1 class="mt-3 text-3xl lg:text-4xl font-semibold tracking-tight">Brew Day with BrewDocs</h1>

        <div class="mt-8 lg:max-w-screen-md text-left flex flex-col gap-4">
            <p class="px-5">
                Brew day is the one day the plan stops being a plan. This walkthrough covers the
                batch's Brewing tab — checking off equipment and ingredients as you use them,
                recording the readings you take, running the session timer, and completing each
                phase on your way through the day. Everything here is done one-handed, standing
                over a kettle, which is roughly the design brief.
            </p>

            <div class="rounded-box glass p-5 [box-shadow:inset_0_0_0_1px_oklch(100%_0_0/22%)]">
                <div class="text-xs font-mono uppercase tracking-widest text-primary">Before you start</div>
                <p class="mt-2 text-base">
                    This guide assumes you already have a batch to brew. If you do not, <a href="/guides/first-recipe" class="link link-primary">Create a Recipe and Plan a Batch</a> gets you one, and <a href="/guides/getting-started" class="link link-primary">Getting Started</a> covers the four places you
                    will spend your time. Everything you record lives in the browser you record it
                    in — nothing is sent anywhere, and nothing follows you to another device.
                </p>
            </div>

            {steps.map(({number, title, lead, body, figures}) => (
                <section class="rounded-box glass p-5 [box-shadow:inset_0_0_0_1px_oklch(100%_0_0/22%)]">
                    <div class="text-xs font-mono uppercase tracking-widest text-primary">Step {number}</div>
                    <h2 class="mt-2 text-xl font-semibold tracking-tight">{title}</h2>
                    <p class="mt-1 text-base opacity-80">{lead}</p>
                    <div class="mt-3 flex flex-col gap-3">
                        {body.map((paragraph) => <p class="text-base">{paragraph}</p>)}
                    </div>
                    <div class="mt-5 flex flex-wrap justify-center gap-8">
                        {figures.map(({src, alt, caption}) => (
                            <figure class="flex flex-col items-center max-w-64">
                                <PhoneMockup
                                    src={src}
                                    label={alt}
                                    class="w-52 sm:w-64 shrink-0 drop-shadow-2xl" />
                                <figcaption class="mt-4 text-sm opacity-70 text-center">{caption}</figcaption>
                            </figure>
                        ))}
                    </div>
                </section>
            ))}

            <div class="px-5">
                <p>
                    Work down the phases that way and the batch ends the day as a record of what
                    you actually did, not what you meant to do — which is the version worth having
                    when you brew it again. What the Summary tab makes of those readings is a
                    story for another guide.
                </p>
                <div class="mt-5 flex flex-wrap gap-3">
                    <a href={APP_URL} class="btn btn-primary">Try the demo</a>
                    <a href="/guides" class="btn btn-ghost">All guides</a>
                </div>
            </div>
        </div>
    </main>
</Layout>
