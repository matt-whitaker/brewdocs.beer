---
import Layout from "@/layouts/Layout.astro";
import {APP_URL} from "@/data/env";

type Guide = {
    title: string;
    description: string;
    href?: string;
};

const guides: Guide[] = [
    {
        title: "Getting Started",
        description: "The four places you will spend your time — Batches, Recipes, Equipment and the knowledge base — and the search box that finds any of them.",
        href: "/guides/getting-started"
    },
    {
        title: "Create a Recipe and Plan a Batch",
        description: "From a blank recipe, or a copy of one out of the catalogue, to a batch planned and ready to brew.",
        href: "/guides/first-recipe"
    },
    {
        title: "Brew Day with BrewDocs",
        description: "The batch's Brewing tab on the day itself: checking off what you use, recording readings, running the timer and completing each phase.",
        href: "/guides/brew-day"
    },
    {
        title: "Intro to Brewing",
        description: "Brewing itself rather than the app — the process, the ingredients and the vocabulary, for anyone starting from nothing."
    }
];
---
<Layout title="Guides">
    <main
        class="min-h-screen w-screen flex flex-col items-center px-6 pt-24 pb-16 lg:pt-28"
        style="background-image: linear-gradient(to bottom, color-mix(in oklab, var(--color-base-200) 85%, transparent) 65%, var(--color-base-300) 100%);">

        <div class="text-xs font-mono uppercase tracking-widest text-primary">User documentation</div>

        <h1 class="mt-3 text-3xl lg:text-4xl font-semibold tracking-tight">Guides</h1>

        <div class="mt-8 lg:max-w-screen-md text-left flex flex-col gap-4">
            <p class="px-5">
                Walkthroughs of BrewDocs, written in the order you are likely to need them:
                finding your way around, getting a recipe and a batch together, and then the
                brew day itself. Each one is a read-through rather than a reference, and
                assumes nothing beyond the one before it.
            </p>

            <div class="flex flex-col gap-3">
                {guides.map(({title, description, href}) => (
                    <section class="rounded-box glass p-5 [box-shadow:inset_0_0_0_1px_oklch(100%_0_0/22%)]">
                        {href
                            ? <div class="text-xs font-mono uppercase tracking-widest text-primary">Walkthrough</div>
                            : <div class="text-xs font-mono uppercase tracking-widest text-base-content/50">Coming soon</div>}
                        <h2 class="mt-2 text-xl font-semibold tracking-tight">
                            {href ? <a href={href} class="link link-primary">{title}</a> : title}
                        </h2>
                        <p class="mt-1 text-base opacity-80">{description}</p>
                    </section>
                ))}
            </div>

            <div class="px-5">
                <p>
                    The guides describe the app as it stands, which is an early prototype — what
                    you enter lives in the browser you enter it in, so a guide is best read with
                    the demo open beside it.
                </p>
                <div class="mt-5 flex flex-wrap gap-3">
                    <a href={APP_URL} class="btn btn-primary">Try the demo</a>
                </div>
            </div>
        </div>
    </main>
</Layout>
