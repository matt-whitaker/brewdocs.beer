---
import Layout from "@/layouts/Layout.astro";
import PhoneMockup from "@/components/phone-mockup.astro";
import {StatusBadge} from "@brewdocs.beer/design";
---
<Layout title="BrewDocs, a homebrewing companion">
    <main class="min-h-screen w-screen bg-base-200 flex items-center justify-center px-6 pt-24 pb-12 lg:pt-16">
        <div class="flex flex-col lg:flex-row items-center gap-10 lg:gap-20 max-w-5xl">
            <!-- left: the app running on a phone -->
            <PhoneMockup class="w-48 sm:w-56 lg:w-72 shrink-0 drop-shadow-2xl" />

            <!-- right: title, status, blurb, link -->
            <div class="text-center lg:text-left max-w-md">
                <h1 class="text-5xl lg:text-6xl font-semibold tracking-tight">
                    Brew<span class="font-light">Docs</span>
                </h1>

                <div class="mt-4 flex justify-center lg:justify-start">
                    <StatusBadge>In Development</StatusBadge>
                </div>

                <p class="mt-6 text-lg opacity-80">
                    BrewDocs is a homebrewing companion for beginner and hobbyist brewers.
                    Plan and record your brew days, with the resources you need always at hand.
                </p>

                <a href="/about" class="btn btn-primary mt-8">Read more</a>
            </div>
        </div>
    </main>
</Layout>
