{
  "name": "brewdocs.beer",
  "version": "0.0.0",
  "private": true,
  "description": "An (offline) web app prototype of a standard brew day application",
  "main": "index.ts",
  "scripts": {
    "build:www": "npm run build -w packages/www",
    "dev:www": "npm run dev -w packages/www",
    "test:www": "npm run test -w packages/www",
    "build:app": "npm run build -w packages/app",
    "dev:app": "npm run dev -w packages/app",
    "test:app": "npm run test -w packages/app",
    "build:kb": "npm run build -w packages/kb",
    "dev:kb": "npm run dev -w packages/kb",
    "test:kb": "npm run test -w packages/kb",
    "build:design": "npm run build -w packages/design",
    "dev:design": "npm run dev -w packages/design",
    "test:design": "npm run test -w packages/design",
    "build": "npm run build -ws",
    "test": "npm test -ws",
    "lint:fix": "npm run lint -ws -- --fix"
  },
  "author": "",
  "license": "ISC",
  "workspaces": [
    "packages/core",
    "packages/app",
    "packages/www",
    "packages/design",
    "packages/kb"
  ]
}
